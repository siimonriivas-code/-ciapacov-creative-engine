{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creative Engine Asset",
  "type": "object",
  "required": ["id","name","category","capabilities","status","availability","source","license"],
  "properties": {
    "id": {"type":"string"},
    "name": {"type":"string"},
    "category": {"type":"string"},
    "capabilities": {"type":"array","items":{"type":"string"}},
    "file": {"type":["string","null"]},
    "status": {"enum":["premium","approved","experimental","slot","deprecated"]},
    "availability": {"enum":["bundled","external-required","external-linked"]},
    "source": {"type":"string"},
    "license": {"type":"object","required":["kind","redistributable"],"properties":{"kind":{"type":"string"},"redistributable":{"type":"boolean"}}},
    "tags": {"type":"array","items":{"type":"string"}},
    "notes": {"type":"string"}
  }
}
