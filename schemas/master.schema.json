    "requiredCapabilities":{"type":"array","items":{"type":"string"}},"recommendedCapabilities":{"type":"array","items":{"type":"string"}},
    "materials":{"type":"array","items":{"type":"string"}},"status":{"enum":["premium","approved","experimental"]}
  }
}
