{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational Master",
  "type": "object",
  "required": ["id","domain","name","objective","formats","templateIds","requiredCapabilities","recommendedCapabilities","materials","status"],
