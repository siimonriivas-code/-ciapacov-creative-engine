{
  "name": "ciapacov-creative-engine",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "validate": "node scripts/validate-registry.mjs",
    "validate:ecosystem": "node scripts/validate-ecosystem.mjs",
    "validate:visuals": "node scripts/validate-v07.mjs",
    "validate:production": "node scripts/validate-v08.mjs",
    "validate:brandqa": "node scripts/validate-v09.mjs",
    "validate:integration": "node scripts/validate-v10.mjs",
    "validate:premium": "node scripts/validate-v11.mjs && node scripts/validate-premium-recipes.mjs",
    "validate:motion-intelligence": "node scripts/validate-motion-intelligence.mjs",
    "validate:all": "npm run validate && npm run validate:ecosystem && npm run validate:visuals && npm run validate:production && npm run validate:brandqa && npm run validate:integration && npm run validate:premium && npm run validate:motion-intelligence",
    "catalog:build": "node scripts/build-compact-catalog.mjs",
    "ecosystem:build": "node scripts/build-ecosystem-compact.mjs",
    "visuals:build": "node scripts/build-visual-library.mjs",
    "production:build": "node scripts/build-production-compact.mjs",
    "qa:build": "node scripts/build-qa-compact.mjs",
    "handoff:build": "node scripts/build-handoff.mjs",
    "qa:real": "node scripts/run-real-qa.mjs",
    "qa:premium": "node scripts/audit-premium-production.mjs",
    "contact-sheets": "node scripts/build-contact-sheets.mjs",
    "catalog:all": "npm run catalog:build && npm run ecosystem:build && npm run visuals:build && npm run production:build && npm run qa:build && npm run handoff:build && npm run contact-sheets",
    "ingest:asset": "node scripts/ingest-asset.mjs",
    "ingest:media": "node scripts/ingest-media.mjs",
    "ingest:motion": "node scripts/ingest-motion-asset.mjs",
    "generate:minimax": "node scripts/generate-minimax-video.mjs",
    "remotion:studio": "remotion studio src/remotion/index.ts --no-open",
    "remotion:render:route": "remotion render src/remotion/index.ts CE-RouteJourney out/route-journey.mp4",
    "remotion:render:documentary": "remotion render src/remotion/index.ts CE-DocumentaryEvidence out/documentary-evidence.mp4",
    "remotion:render:before-after": "remotion render src/remotion/index.ts CE-BeforeAfter out/before-after.mp4"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "gsap": "^3.13.0",
    "motion": "^12.43.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "4.0.506",
    "@remotion/cli": "4.0.506",
    "@remotion/lottie": "4.0.506",
    "lottie-web": "^5.12.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0"
  }
}
